{
  "name": "check-auditorio",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @check-auditorio/web dev",
    "build": "pnpm --filter @check-auditorio/web build",
    "start": "pnpm --filter @check-auditorio/web start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "e2e": "pnpm --filter @check-auditorio/web e2e",
    "secretos": "node scripts/generar-secretos.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3"
  }
}
